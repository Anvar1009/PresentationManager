<Project Sdk="Microsoft.NET.Sdk.Web">

  <!-- net8.0-windows, not plain net8.0 - matches every other project in the solution (Application,
       Infrastructure, TelegramBot, BotService), which is what lets this project reference them at all
       (a plain net8.0 project can't ProjectReference a net8.0-windows one). Same story as BotService: this
       runs on a Linux server via self-contained publish regardless of the Windows-flavored TFM - nothing
       here actually calls a Windows-only API. -->
  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <!-- Unlike BotService, the linux-x64/self-contained/single-file settings are NOT hardcoded here. Baking a
       linux-x64 RuntimeIdentifier into the project unconditionally would make everyday `dotnet build`/
       `dotnet run` produce a Linux apphost that can't execute on this Windows dev machine, which matters for
       this particular project since it's the one meant to be run locally against a dev Postgres while
       building controllers. The deployment publish command instead passes the runtime identifier and
       self-contained/single-file flags explicitly on the command line - see
       presentationmanager-api.service's accompanying notes for the exact invocation. -->

  <PropertyGroup Condition="'$(Configuration)'=='Release'">
    <DebugType>none</DebugType>
  </PropertyGroup>

  <!-- appsettings.json itself is already picked up by Sdk.Web's default Content globbing - only the
       optional, gitignored local-override file needs to be added explicitly. -->
  <ItemGroup>
    <Content Include="appsettings.Local.json" Condition="Exists('appsettings.Local.json')">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting.Systemd" Version="8.0.1" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="8.0.10" />
    <!-- Dev-tooling only (dotnet ef migrations add) - this is now the project EF tools resolve the
         design-time context from (moved here from PresentationManager.UI, which no longer touches the
         database directly). -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="8.0.10">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <!-- Same version as PresentationManager.UI's own ExcelExportHelper - server-side final-scores export for
         the web Admin/SuperAdmin panels (FinalScoresExcelExporter). -->
    <PackageReference Include="ClosedXML" Version="0.105.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\PresentationManager.Application\PresentationManager.Application.csproj" />
    <ProjectReference Include="..\PresentationManager.Infrastructure\PresentationManager.Infrastructure.csproj" />
    <ProjectReference Include="..\PresentationManager.TelegramBot\PresentationManager.TelegramBot.csproj" />
  </ItemGroup>

</Project>
