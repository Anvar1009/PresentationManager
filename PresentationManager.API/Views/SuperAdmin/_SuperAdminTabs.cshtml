@model SuperAdminTabsViewModel

<nav class="tabs">
    <a class="tab @(Model.Active == "dashboard" ? "active" : "")" asp-controller="SuperAdmin" asp-action="Dashboard">
        <svg class="icon" viewBox="0 0 24 24"><path d="M3 9.5 12 3l9 6.5V20a1 1 0 0 1-1 1h-5v-7H9v7H4a1 1 0 0 1-1-1z" /></svg>
        Bosh sahifa
    </a>
</nav>

<span class="sidebar-group-label">Boshqaruv</span>
<nav class="tabs">
    <a class="tab @(Model.Active == "projects" ? "active" : "")" asp-controller="SuperAdmin" asp-action="Projects">
        <svg class="icon" viewBox="0 0 24 24"><path d="M22 19a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h5l2 3h9a2 2 0 0 1 2 2z" /></svg>
        Loyihalar
    </a>
    <a class="tab @(Model.Active == "presentations" ? "active" : "")" asp-controller="SuperAdmin" asp-action="Presentations">
        <svg class="icon" viewBox="0 0 24 24"><rect x="2" y="3" width="20" height="14" rx="2" /><line x1="8" y1="21" x2="16" y2="21" /><line x1="12" y1="17" x2="12" y2="21" /></svg>
        Taqdimotlar
    </a>
    <a class="tab @(Model.Active == "presenters" ? "active" : "")" asp-controller="SuperAdmin" asp-action="Presenters">
        <svg class="icon" viewBox="0 0 24 24"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2" /><circle cx="9" cy="7" r="4" /><path d="M22 21v-2a4 4 0 0 0-3-3.87" /><path d="M16 3.13a4 4 0 0 1 0 7.75" /></svg>
        Taqdimotchilar
    </a>
    <a class="tab @(Model.Active == "judges" ? "active" : "")" asp-controller="SuperAdmin" asp-action="Judges">
        <svg class="icon" viewBox="0 0 24 24"><circle cx="12" cy="8" r="6" /><path d="M15.5 13.5 17 22l-5-3-5 3 1.5-8.5" /></svg>
        Hakamlar
    </a>
    <a class="tab @(Model.Active == "users" ? "active" : "")" asp-controller="SuperAdmin" asp-action="Users">
        <svg class="icon" viewBox="0 0 24 24"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2" /><circle cx="12" cy="7" r="4" /></svg>
        Foydalanuvchilar
    </a>
    <a class="tab @(Model.Active == "scores" ? "active" : "")" asp-controller="SuperAdmin" asp-action="Scores">
        <svg class="icon" viewBox="0 0 24 24"><polygon points="12 2 15 8.5 22 9.5 17 14.5 18 21.5 12 18 6 21.5 7 14.5 2 9.5 9 8.5 12 2" /></svg>
        Baholar
    </a>
</nav>

<span class="sidebar-group-label">Tizim</span>
<nav class="tabs">
    <a class="tab @(Model.Active == "jurnal" ? "active" : "")" asp-controller="SuperAdmin" asp-action="Jurnal">
        <svg class="icon" viewBox="0 0 24 24"><circle cx="12" cy="12" r="10" /><polyline points="12 6 12 12 16 14" /></svg>
        Jurnal
    </a>
</nav>
