@model SuperAdminScoresViewModel
@{
    ViewData["Title"] = "Baholar";
    ViewData["Brand"] = "SuperAdmin paneli";
    ViewData["Wide"] = "container-wide";
}

<span class="eyebrow">Baholar</span>
<h1 class="page-title">Baholar</h1>
<p class="page-subtitle">Barcha loyihalar bo'yicha har bir hakamning qo'ygan bahosi (faqat ko'rish rejimi).</p>

<partial name="_SuperAdminTabs" model='new SuperAdminTabsViewModel("scores")' />

<div class="toolbar">
    <form method="get" asp-controller="SuperAdmin" asp-action="Scores">
        <input type="text" name="q" value="@Model.Query" placeholder="Taqdimot, hakam yoki mezon bo'yicha qidirish..." />
    </form>
</div>

@if (Model.Rows.Count == 0)
{
    <div class="card empty-state">Hech narsa topilmadi.</div>
}
else
{
    <div class="table-wrap">
        <table class="table">
            <thead>
                <tr>
                    <th>Taqdimot</th>
                    <th>Hakam</th>
                    <th>Mezon</th>
                    <th>Ball</th>
                    <th>Yangilangan vaqt</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var row in Model.Rows)
                {
                    <tr>
                        <td class="wrap">@row.PresentationTitle</td>
                        <td>@row.JudgePhone</td>
                        <td>@row.CriterionName</td>
                        <td>@row.Value</td>
                        <td>@row.UpdatedAt</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
