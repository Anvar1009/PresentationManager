@{
    ViewData["Title"] = "Bosh sahifa";
}

<div class="login-shell">
    <div class="card login-card" style="text-align: center;">
        <div class="login-mark" style="justify-content: center;">
            <span class="brand-dot"></span>
            Taqdimotlar tizimi
        </div>
        <h1 class="page-title">Taqdimotlar boshqaruv tizimi</h1>
        <p class="page-subtitle" style="margin-left: auto; margin-right: auto;">
            Loyihalar, taqdimotchilar, hakamlar va taqdimot tartibini boshqarish uchun yagona platforma.
        </p>
        <a class="btn btn-block" asp-controller="Account" asp-action="Login">
            <svg class="icon" viewBox="0 0 24 24"><path d="M15 3h4a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2h-4" /><polyline points="10 17 15 12 10 7" /><line x1="15" y1="12" x2="3" y2="12" /></svg>
            Kirish
        </a>
    </div>
</div>
