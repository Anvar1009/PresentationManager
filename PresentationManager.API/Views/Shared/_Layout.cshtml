@{
    // Set by each area's own dashboard view (e.g. Judge/Dashboard.cshtml sets "Hakamlar paneli",
    // Order/Dashboard.cshtml sets "Tartib paneli") - defaults to something generic for Login, which is
    // shared by both web-only roles and doesn't know which one is signing in until after the password check.
    var brand = ViewData["Brand"] as string ?? "Boshqaruv paneli";
}
<!DOCTYPE html>
<html lang="uz">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@(ViewData["Title"] is string t && t.Length > 0 ? $"{t} — {brand}" : brand)</title>
    <link rel="stylesheet" href="~/css/site.css" />
</head>
<body data-project-id="@(ViewData["ProjectId"])">
    @if (User.Identity?.IsAuthenticated == true)
    {
        <div class="topbar">
            <div class="brand">
                <span class="brand-dot" title="Real-vaqt ulanish"></span>
                @brand
            </div>
            <div class="account">
                <span class="account-name">@User.Identity!.Name</span>
                <form asp-controller="Account" asp-action="Logout" method="post">
                    <button type="submit" class="btn btn-outline">
                        <svg class="icon" viewBox="0 0 24 24"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4" /><polyline points="16 17 21 12 16 7" /><line x1="21" y1="12" x2="9" y2="12" /></svg>
                        Chiqish
                    </button>
                </form>
            </div>
        </div>
    }

    <div class="container @(ViewData["Wide"] as string)">
        @RenderBody()
    </div>

    <script src="https://cdn.jsdelivr.net/npm/@@microsoft/signalr@8.0.7/dist/browser/signalr.min.js"></script>
    <script src="~/js/order-live.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
