@model AdminPresentersViewModel
@{
    ViewData["Title"] = "Ishtirokchilar";
    ViewData["Brand"] = "Admin paneli";
    ViewData["Wide"] = "container-wide";
}

@section Sidebar {
    <partial name="_ProjectTabs" model='new AdminProjectTabsViewModel(Model.ProjectId, "presenters")' />
}

<span class="eyebrow">Ishtirokchilar</span>
<h1 class="page-title">@Model.ProjectName</h1>
<p class="page-subtitle">Faqat botga /start bosib kontaktini ulashgan odamlar biriktirilishi mumkin.</p>

@if (TempData["Error"] is string error)
{
    <div class="validation-summary">@error</div>
}

@if (Model.Assigned.Count == 0)
{
    <div class="card empty-state" style="margin-bottom: var(--space-5);">Hali ishtirokchi biriktirilmagan.</div>
}
else
{
    <div class="table-wrap">
        <table class="table">
            <thead>
                <tr>
                    <th>Ism</th>
                    <th>Telefon</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var row in Model.Assigned)
                {
                    <tr>
                        <td>@row.FullName</td>
                        <td>@(row.PhoneNumber ?? "-")</td>
                        <td>
                            <form asp-controller="Admin" asp-action="DeletePresenterAssignment" method="post" style="margin: 0;">
                                <input type="hidden" name="id" value="@row.AssignmentId" />
                                <input type="hidden" name="projectId" value="@Model.ProjectId" />
                                <button type="submit" class="btn btn-sm btn-danger">O'chirish</button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

<div class="card" style="max-width: 420px;">
    <span class="eyebrow">+ Ishtirokchi biriktirish</span>
    @if (Model.Candidates.Count == 0)
    {
        <p class="page-subtitle" style="margin: 0;">Hozircha botga ro'yxatdan o'tgan (va hali biriktirilmagan) odam yo'q.</p>
    }
    else
    {
        <form asp-controller="Admin" asp-action="AssignPresenter" method="post">
            <input type="hidden" name="projectId" value="@Model.ProjectId" />
            <div class="field">
                <label for="presenterId">Odam</label>
                <select id="presenterId" name="presenterId" required>
                    @foreach (var candidate in Model.Candidates)
                    {
                        <option value="@candidate.Id">@candidate.FullName - @candidate.PhoneNumber</option>
                    }
                </select>
            </div>
            <button type="submit" class="btn">+ Ishtirokchi biriktirish</button>
        </form>
    }
</div>
