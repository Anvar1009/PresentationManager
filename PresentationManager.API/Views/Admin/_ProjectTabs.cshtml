@model AdminProjectTabsViewModel

<a class="sidebar-back" asp-controller="Admin" asp-action="Dashboard">&larr; Loyihalar</a>
<nav class="tabs">
    <a class="tab @(Model.Active == "participants" ? "active" : "")" asp-controller="Admin" asp-action="Participants" asp-route-projectId="@Model.ProjectId">
        <svg class="icon" viewBox="0 0 24 24"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2" /><circle cx="9" cy="7" r="4" /><path d="M22 21v-2a4 4 0 0 0-3-3.87" /><path d="M16 3.13a4 4 0 0 1 0 7.75" /></svg>
        Qatnashchilar
    </a>
    <a class="tab @(Model.Active == "presentations" ? "active" : "")" asp-controller="Admin" asp-action="Presentations" asp-route-projectId="@Model.ProjectId">
        <svg class="icon" viewBox="0 0 24 24"><rect x="2" y="3" width="20" height="14" rx="2" /><line x1="8" y1="21" x2="16" y2="21" /><line x1="12" y1="17" x2="12" y2="21" /></svg>
        Taqdimotlar
    </a>
    <a class="tab @(Model.Active == "finalscores" ? "active" : "")" asp-controller="Admin" asp-action="FinalScores" asp-route-projectId="@Model.ProjectId">
        <svg class="icon" viewBox="0 0 24 24"><polygon points="12 2 15 8.5 22 9.5 17 14.5 18 21.5 12 18 6 21.5 7 14.5 2 9.5 9 8.5 12 2" /></svg>
        Yakuniy baholar
    </a>
    <a class="tab @(Model.Active == "criteria" ? "active" : "")" asp-controller="Admin" asp-action="Criteria" asp-route-projectId="@Model.ProjectId">
        <svg class="icon" viewBox="0 0 24 24"><path d="M9 11l3 3L22 4" /><path d="M21 12v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11" /></svg>
        Baholash mezonlari
    </a>
    <a class="tab @(Model.Active == "judges" ? "active" : "")" asp-controller="Admin" asp-action="Judges" asp-route-projectId="@Model.ProjectId">
        <svg class="icon" viewBox="0 0 24 24"><circle cx="12" cy="8" r="6" /><path d="M15.5 13.5 17 22l-5-3-5 3 1.5-8.5" /></svg>
        Hakamlar
    </a>
    <a class="tab @(Model.Active == "presenters" ? "active" : "")" asp-controller="Admin" asp-action="Presenters" asp-route-projectId="@Model.ProjectId">
        <svg class="icon" viewBox="0 0 24 24"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2" /><circle cx="12" cy="7" r="4" /></svg>
        Ishtirokchilar
    </a>
</nav>
