@model PresenterUploadViewModel
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="uz">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>Taqdimot yuborish</title>
    <script src="https://telegram.org/js/telegram-web-app.js"></script>
    <style>
        :root {
            --bg: var(--tg-theme-bg-color, #14161d);
            --card: var(--tg-theme-secondary-bg-color, #191c25);
            --fg: var(--tg-theme-text-color, #f2f2f2);
            --hint: var(--tg-theme-hint-color, #8a8f9c);
            --accent: var(--tg-theme-button-color, #e8a33d);
            --accent-fg: var(--tg-theme-button-text-color, #14161d);
            --danger: #e5484d;
            --ok: #3fb950;
        }

        * { box-sizing: border-box; -webkit-tap-highlight-color: transparent; }

        body {
            margin: 0;
            min-height: 100vh;
            background: var(--bg);
            color: var(--fg);
            font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
            padding: 18px 14px 40px;
        }

        .page { max-width: 480px; margin: 0 auto; }

        .hello {
            font-size: 1rem;
            font-weight: 600;
            margin: 4px 0 2px;
        }

        .hint {
            color: var(--hint);
            font-size: 0.86rem;
            margin: 0 0 18px;
            line-height: 1.4;
        }

        .step-label {
            font-size: 0.72rem;
            font-weight: 700;
            letter-spacing: 0.04em;
            text-transform: uppercase;
            color: var(--accent);
            margin: 0 0 8px;
        }

        .card {
            background: var(--card);
            border-radius: 16px;
            padding: 16px;
            margin-bottom: 16px;
        }

        .error {
            background: rgba(229, 72, 77, 0.15);
            color: var(--danger);
            border-radius: 10px;
            padding: 10px 12px;
            font-size: 0.88rem;
            margin-bottom: 14px;
        }

        .empty-state {
            text-align: center;
            padding: 30px 10px;
            color: var(--hint);
            font-size: 0.92rem;
            line-height: 1.5;
        }

        /* ---- project picker ---- */
        .project-option {
            display: block;
            border: 1.5px solid rgba(255, 255, 255, 0.1);
            border-radius: 12px;
            padding: 12px 14px;
            margin-bottom: 8px;
            cursor: pointer;
            transition: border-color 0.15s, background 0.15s;
        }

        .project-option:last-child { margin-bottom: 0; }

        .project-option input[type="radio"] { display: none; }

        .project-option.selected {
            border-color: var(--accent);
            background: rgba(232, 163, 61, 0.08);
        }

        .project-option.disabled {
            opacity: 0.45;
            cursor: default;
        }

        .project-option-head {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 8px;
        }

        .project-option-name { font-weight: 600; font-size: 0.96rem; }

        .radio-dot {
            width: 18px;
            height: 18px;
            border-radius: 50%;
            border: 1.5px solid var(--hint);
            flex: none;
            position: relative;
        }

        .project-option.selected .radio-dot {
            border-color: var(--accent);
        }

        .project-option.selected .radio-dot::after {
            content: "";
            position: absolute;
            inset: 3px;
            border-radius: 50%;
            background: var(--accent);
        }

        .project-option-meta {
            margin-top: 4px;
            font-size: 0.78rem;
            color: var(--hint);
        }

        .project-option-meta.deadline-expired { color: var(--danger); }
        .project-option-meta.existing { color: var(--ok); }

        /* ---- title / file ---- */
        input[type="text"] {
            width: 100%;
            background: var(--bg);
            border: 1.5px solid rgba(255, 255, 255, 0.12);
            border-radius: 10px;
            padding: 12px 13px;
            color: var(--fg);
            font-size: 0.95rem;
        }

        input[type="text"]:focus {
            outline: none;
            border-color: var(--accent);
        }

        .file-picker {
            display: block;
            border: 1.5px dashed var(--hint);
            border-radius: 12px;
            padding: 16px;
            text-align: center;
            cursor: pointer;
            font-size: 0.93rem;
        }

        .file-picker.has-file {
            border-style: solid;
            border-color: var(--accent);
        }

        input[type="file"] { display: none; }

        .submit-btn {
            width: 100%;
            border: none;
            border-radius: 12px;
            padding: 15px;
            font-size: 1rem;
            font-weight: 600;
            background: var(--accent);
            color: var(--accent-fg);
            cursor: pointer;
        }

        .submit-btn:disabled { opacity: 0.5; cursor: default; }

        .progress-wrap { display: none; margin-top: 14px; }

        .progress-track {
            background: rgba(255, 255, 255, 0.12);
            border-radius: 8px;
            height: 8px;
            overflow: hidden;
        }

        .progress-fill {
            height: 100%;
            width: 0%;
            background: var(--accent);
            transition: width 0.15s;
        }

        .progress-label {
            font-size: 0.8rem;
            color: var(--hint);
            margin-top: 6px;
            text-align: center;
        }
    </style>
</head>
<body>
    <div class="page">
        <div class="hello">👋 @Model.FullName</div>
        <p class="hint">To'liq taqdimotni shu yerdan yuboring - loyihani tanlang, sarlavha yozing va faylni yuklang. 20MB cheklovi bu yerda qo'llanilmaydi.</p>

        @if (Model.Error is { } error)
        {
            <div class="error">@error</div>
        }

        @if (Model.Projects.Count == 0)
        {
            <div class="card empty-state">Hozircha sizga biriktirilgan loyiha yo'q. Administrator tasdiqlagach, botga qaytib qaytadan urinib ko'ring.</div>
        }
        else
        {
            <form id="uploadForm">
                <input type="hidden" name="token" value="@Model.Token" />

                <div class="step-label">1. Loyiha</div>
                <div class="card" id="projectList">
                    @foreach (var p in Model.Projects)
                    {
                        var isSelected = Model.SelectedProjectId == p.ProjectId;
                        <label class="project-option @(p.IsExpired ? "disabled" : "") @(isSelected ? "selected" : "")" data-project-id="@p.ProjectId" data-expired="@(p.IsExpired ? "1" : "0")">
                            <input type="radio" name="projectId" value="@p.ProjectId" @(p.IsExpired ? "disabled" : "") @(isSelected ? "checked" : "") />
                            <div class="project-option-head">
                                <span class="project-option-name">@p.ProjectName</span>
                                <span class="radio-dot"></span>
                            </div>
                            @if (p.IsExpired)
                            {
                                <div class="project-option-meta deadline-expired">Muddat tugagan (@p.DeadlineText)</div>
                            }
                            else if (p.DeadlineText is not null)
                            {
                                <div class="project-option-meta">Muddat: @p.DeadlineText</div>
                            }
                            @if (p.ExistingTitle is not null)
                            {
                                <div class="project-option-meta existing">Allaqachon yuborilgan: "@p.ExistingTitle" - yangi fayl shuni almashtiradi</div>
                            }
                        </label>
                    }
                </div>

                <div class="step-label">2. Sarlavha</div>
                <div class="card">
                    <input type="text" id="titleInput" name="title" placeholder="Taqdimot sarlavhasi" value="@Model.Title" autocomplete="off" />
                </div>

                <div class="step-label">3. Fayl</div>
                <div class="card">
                    <label class="file-picker" id="filePicker" for="fileInput">📎 Faylni tanlash (.ppt, .pptx, .pdf)</label>
                    <input type="file" id="fileInput" name="file" accept=".ppt,.pptx,.pdf" />

                    <div class="progress-wrap" id="progressWrap">
                        <div class="progress-track"><div class="progress-fill" id="progressFill"></div></div>
                        <div class="progress-label" id="progressLabel">Yuklanmoqda...</div>
                    </div>
                </div>

                <button type="submit" class="submit-btn" id="submitBtn" disabled>Yuborish</button>
            </form>
        }
    </div>

    <script>
        (function () {
            var tg = window.Telegram && window.Telegram.WebApp;
            if (tg) {
                tg.ready();
                tg.expand();
            }

            var form = document.getElementById('uploadForm');
            if (!form) {
                return;
            }

            var projectList = document.getElementById('projectList');
            var titleInput = document.getElementById('titleInput');
            var fileInput = document.getElementById('fileInput');
            var filePicker = document.getElementById('filePicker');
            var submitBtn = document.getElementById('submitBtn');
            var progressWrap = document.getElementById('progressWrap');
            var progressFill = document.getElementById('progressFill');
            var progressLabel = document.getElementById('progressLabel');

            function selectedProjectId() {
                var checked = projectList.querySelector('input[name="projectId"]:checked');
                return checked ? checked.value : null;
            }

            function updateSubmitState() {
                var ok = selectedProjectId() && titleInput.value.trim().length > 0 && fileInput.files.length > 0;
                submitBtn.disabled = !ok;
            }

            projectList.querySelectorAll('.project-option').forEach(function (opt) {
                if (opt.dataset.expired === '1') {
                    return;
                }
                opt.addEventListener('click', function () {
                    projectList.querySelectorAll('.project-option').forEach(function (o) { o.classList.remove('selected'); });
                    opt.classList.add('selected');
                    opt.querySelector('input[type="radio"]').checked = true;
                    updateSubmitState();
                });
            });

            titleInput.addEventListener('input', updateSubmitState);

            fileInput.addEventListener('change', function () {
                if (fileInput.files.length > 0) {
                    filePicker.textContent = '📎 ' + fileInput.files[0].name;
                    filePicker.classList.add('has-file');
                } else {
                    filePicker.textContent = '📎 Faylni tanlash (.ppt, .pptx, .pdf)';
                    filePicker.classList.remove('has-file');
                }
                updateSubmitState();
            });

            updateSubmitState();

            form.addEventListener('submit', function (e) {
                e.preventDefault();
                if (submitBtn.disabled) {
                    return;
                }

                var formData = new FormData();
                formData.append('token', @Html.Raw(Json.Serialize(Model.Token)));
                formData.append('projectId', selectedProjectId());
                formData.append('title', titleInput.value.trim());
                formData.append('file', fileInput.files[0]);

                submitBtn.disabled = true;
                submitBtn.textContent = 'Yuklanmoqda...';
                progressWrap.style.display = 'block';

                var xhr = new XMLHttpRequest();
                xhr.open('POST', window.location.pathname + window.location.search, true);
                xhr.upload.onprogress = function (evt) {
                    if (evt.lengthComputable) {
                        var pct = Math.round((evt.loaded / evt.total) * 100);
                        progressFill.style.width = pct + '%';
                        progressLabel.textContent = pct + '%';
                    }
                };
                xhr.onload = function () {
                    document.open();
                    document.write(xhr.responseText);
                    document.close();
                };
                xhr.onerror = function () {
                    submitBtn.disabled = false;
                    submitBtn.textContent = 'Yuborish';
                    progressLabel.textContent = 'Tarmoq xatoligi - qaytadan urinib ko\'ring.';
                };
                xhr.send(formData);
            });
        })();
    </script>
</body>
</html>
