@model OrderDashboardViewModel
@{
    ViewData["Title"] = "Loyihalar";
    ViewData["Brand"] = "Tartib paneli";
}

<span class="eyebrow">Tartib operatori · @Model.OrderOperatorFullName</span>
<h1 class="page-title">Loyihalar</h1>
<p class="page-subtitle">Tartibni shakllantirish uchun loyihani tanlang.</p>

@if (Model.Projects.Count == 0)
{
    <div class="card empty-state">Hozircha loyihalar yo'q.</div>
}
else
{
    <div class="card-grid">
        @foreach (var project in Model.Projects)
        {
            <a class="card card-link" asp-controller="Order" asp-action="Project" asp-route-projectId="@project.ProjectId">
                <span class="card-title">@project.ProjectName</span>
                @if (project.PresentationCount == 0)
                {
                    <span class="card-meta">Hali taqdimotchi yo'q</span>
                }
                else
                {
                    <span class="card-meta">@project.PresentationCount ta taqdimotchi</span>
                }
                @if (project.IsOrdered)
                {
                    <span class="badge badge-success" style="margin-top: var(--space-2); gap: 4px;">
                        <svg class="icon" viewBox="0 0 24 24" style="width: 12px; height: 12px;"><polyline points="20 6 9 17 4 12" /></svg>
                        Tartiblangan
                    </span>
                }
            </a>
        }
    </div>
}
