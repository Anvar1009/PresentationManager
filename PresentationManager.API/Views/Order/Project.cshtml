@model OrderProjectViewModel
@{
    ViewData["Title"] = Model.ProjectName;
    ViewData["Brand"] = "Tartib paneli";
    // Lets order-live.js auto-reload this exact page when another tab/operator (or the desktop AdminForm's
    // own drag-and-drop reorder) changes this project's order - see _Layout.cshtml/order-live.js, and
    // Judge/Project.cshtml for the same pattern. Without this the list could silently go stale while open.
    ViewData["ProjectId"] = Model.ProjectId;
}

@section Sidebar {
    <a class="sidebar-back" asp-controller="Order" asp-action="Dashboard">&larr; Loyihalar</a>
}

<div class="order-stage" id="orderStage">
    @* Only rendered/visible while fullscreen (display:none otherwise, see site.css) - a starfield backdrop
       and a presentation-style header/heading standing in for the outer panel's own chrome, which stays
       hidden here on purpose (see .order-stage-header rules below). *@
    <div class="stage-stars" id="stageStars" aria-hidden="true"></div>

    <div class="stage-fs-header">
        <div class="stage-fs-brand">
            <span class="stage-fs-mark">
                <svg class="icon" viewBox="0 0 24 24"><rect x="3" y="3" width="7" height="7" rx="1.5" /><rect x="14" y="3" width="7" height="7" rx="1.5" /><rect x="3" y="14" width="7" height="7" rx="1.5" /><rect x="14" y="14" width="7" height="7" rx="1.5" /></svg>
            </span>
            <span>
                <span class="stage-fs-title">@Model.ProjectName</span>
                <span class="stage-fs-subtitle">Taqdimotlar tizimi</span>
            </span>
        </div>
        <div class="stage-fs-badge">
            <span class="stage-fs-badge-dot"></span>
            <span>
                <span class="stage-fs-badge-title">Jonli tartib</span>
                <span class="stage-fs-badge-meta">@Model.PresenterNames.Count ta ishtirokchi</span>
            </span>
        </div>
    </div>

    <h2 class="stage-fs-heading" id="stageHeading">Taqdimotchilar tartibi</h2>

    <div class="order-stage-header">
        <div class="order-stage-heading">
            <span class="eyebrow">Taqdimotchilar</span>
            <h1 class="page-title">@Model.ProjectName</h1>
            <p class="page-subtitle">Joriy tartib quyida ko'rsatilgan. Pastdagi tugma bosilganda tartib tasodifiy shakllantiriladi va operatorning navbat oynasida darhol yangilanadi.</p>
        </div>
        <button type="button" class="btn btn-outline btn-icon" id="fullscreenBtn" title="To'liq ekran">
            <svg class="icon" viewBox="0 0 24 24"><path d="M8 3H5a2 2 0 0 0-2 2v3" /><path d="M21 8V5a2 2 0 0 0-2-2h-3" /><path d="M3 16v3a2 2 0 0 0 2 2h3" /><path d="M16 21h3a2 2 0 0 0 2-2v-3" /></svg>
            <span class="fullscreen-label">To'liq ekran</span>
        </button>
    </div>

    @if (TempData["Success"] is string success)
    {
        <div class="notice-success" style="margin-top: var(--space-5);">@success</div>
    }

    @if (Model.PresenterNames.Count == 0)
    {
        <div class="card empty-state" style="margin-top: var(--space-5);">Bu loyihada hali taqdimotchilar yo'q.</div>
    }
    else
    {
        <div class="card queue" id="queueList" style="margin-top: var(--space-5);">
            @{ var index = 0; }
            @foreach (var name in Model.PresenterNames)
            {
                index++;
                <div class="queue-row">
                    <span class="queue-index">@index.ToString("00")</span>
                    <div class="queue-body">
                        <div class="queue-name">@name</div>
                    </div>
                </div>
            }
        </div>

        <div class="order-actions-row" style="margin-top: var(--space-5);">
            @if (Model.PresenterNames.Count >= 2)
            {
                <form asp-controller="Order" asp-action="Randomize" method="post" id="randomizeForm">
                    <input type="hidden" name="projectId" value="@Model.ProjectId" />
                    <button type="submit" class="btn btn-sm btn-block btn-randomize" id="randomizeBtn">
                        <svg class="icon" viewBox="0 0 24 24"><polyline points="16 3 21 3 21 8" /><line x1="4" y1="20" x2="21" y2="3" /><polyline points="21 16 21 21 16 21" /><line x1="15" y1="15" x2="21" y2="21" /><line x1="4" y1="4" x2="9" y2="9" /></svg>
                        Ro'yxatni shakllantirish
                    </button>
                </form>
            }

            @* Rehearsal-reset for this stage - restores presenters to alphabetical order (no day grouping) so
               any test draws run while checking the fullscreen presentation don't carry over into the real
               one. Stays outside .order-stage-header on purpose so it's still reachable while fullscreen
               (hidden there separately via #resetForm, see site.css - this control is for the outer panel
               only). *@
            <form asp-controller="Order" asp-action="Reset" method="post" id="resetForm">
                <input type="hidden" name="projectId" value="@Model.ProjectId" />
                <button type="submit" class="btn btn-outline btn-sm btn-block" id="resetBtn">
                    <svg class="icon" viewBox="0 0 24 24"><path d="M3 12a9 9 0 1 0 3-6.7" /><polyline points="3 4 3 9 8 9" /></svg>
                    Jadvalni tozalash
                </button>
            </form>
        </div>

        @if (Model.PresenterNames.Count < 2)
        {
            <p class="field-hint" style="margin-top: var(--space-4);">Tasodifiy tartib shakllantirish uchun kamida 2 ta taqdimotchi kerak.</p>
        }
        else
        {
            <p class="card-meta-mono" style="margin-top: var(--space-3);">Har bir mumkin bo'lgan tartib bir xil ehtimollik bilan tanlanadi.</p>
        }
    }
</div>

@section Scripts {
    <script src="~/js/order-shuffle.js" asp-append-version="true"></script>
}
