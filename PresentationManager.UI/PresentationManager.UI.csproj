<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationIcon>app.ico</ApplicationIcon>
  </PropertyGroup>

  <!-- `dotnet publish -c Release` produces a single self-contained .exe (the .NET runtime itself gets
       bundled in, so target machines don't need the .NET 8 runtime installed separately). Two things still
       can't be bundled and must already be present on the target machine: PowerPoint desktop (COM interop -
       see the "office" Reference below) and the WebView2 Runtime (present by default on Windows 10/11, but
       not on older/stripped-down installs). These only take effect for `publish`, not the everyday `build`. -->
  <PropertyGroup>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
  </PropertyGroup>

  <!-- Release publish only: no .pdb debug symbols - end users distributing this to other machines have no
       use for them, and libSkiaSharp's alone outweighs the actual .exe. -->
  <PropertyGroup Condition="'$(Configuration)'=='Release'">
    <DebugType>none</DebugType>
  </PropertyGroup>

  <!-- Trims the publish folder down to just the two files an end user actually needs (the .exe and
       appsettings.json) after every `dotnet publish`: .pdb debug symbols (DebugType=none above stops most,
       but referenced projects and the native SkiaSharp.pdb content asset still land here regardless) and
       WebView2's IntelliSense .xml docs are dev-only noise; appsettings.Local.json is this developer's own
       gitignored file carrying real secrets (DB password, Telegram bot token, loaded only when present -
       see Program.cs) that must never leave this machine, let alone ship to whoever ends up running the
       published .exe. -->
  <Target Name="TrimPublishOutputForDistribution" AfterTargets="Publish">
    <ItemGroup>
      <_FilesToRemoveFromPublish Include="$(PublishDir)*.pdb" />
      <_FilesToRemoveFromPublish Include="$(PublishDir)Microsoft.Web.WebView2.*.xml" />
      <_FilesToRemoveFromPublish Include="$(PublishDir)appsettings.Local.json" />
    </ItemGroup>
    <Delete Files="@(_FilesToRemoveFromPublish)" />
  </Target>

  <ItemGroup>
    <!-- Baked into the exe itself (not copied alongside it) - it's only ever the placeholder template that
         Program.cs seeds into %LocalAppData%\PresentationManager\appsettings.json on first run; the file
         actually read at runtime lives there, not next to the exe. See EnsureAppDataConfigSeeded. -->
    <EmbeddedResource Include="appsettings.json" />
    <Content Include="appsettings.Local.json" Condition="Exists('appsettings.Local.json')">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <!-- Same "baked into the exe, not a loose file next to it" reasoning as appsettings.json above - a
         single-file publish shouldn't depend on a separate .mp3 shipping alongside the .exe. Read back via
         Assembly.GetManifestResourceStream in AlarmSoundService.PlayCountdownBell and played straight from
         that stream (NAudio's Mp3FileReader takes a Stream directly), never touching disk. -->
    <EmbeddedResource Include="Sounds\timer-alarm.mp3" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="ClosedXML" Version="0.105.1" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="8.0.1" />
    <!-- AddHttpClient/IHttpClientFactory for the typed HttpClients registered in Program.cs against
         PresentationManager.ApiClient's Http*Repository classes. -->
    <PackageReference Include="Microsoft.Extensions.Http" Version="8.0.1" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.2957.106" />
    <PackageReference Include="Microsoft.Office.Interop.PowerPoint" Version="15.0.4420.1018" />
    <PackageReference Include="PDFtoImage" Version="5.3.0" />
    <!-- System.Media.SoundPlayer (used elsewhere in AlarmSoundService for the operator's own custom .wav)
         only understands .wav - NAudio is what actually decodes/plays the bundled .mp3 countdown bell. -->
    <PackageReference Include="NAudio" Version="2.2.1" />
  </ItemGroup>

  <ItemGroup>
    <!-- The PowerPoint PIA above depends on the Office "core" PIA (Microsoft.Office.Core.MsoTriState etc.),
         which isn't published as its own NuGet package. It ships instead as part of any Office desktop
         install's Primary Interop Assemblies, at this well-known, version-stable GAC location (unchanged
         since Office 2007 through current 365/2019/2021 desktop installs) — used here only to resolve
         types at BUILD time on this machine.
         Private=true (the default, stated explicitly here) copies office.dll into our own build/publish
         output instead of relying on it being present at runtime. That copy matters for two reasons: (1)
         modern .NET does not consult the machine GAC at all the way .NET Framework did, so a GAC-only
         reference silently fails to resolve at runtime even when Office is installed — this was the actual
         cause of "Slaydni ko'rsatishda xatolik" on a real PowerPoint file; (2) the Microsoft.Office.Interop.
         PowerPoint package above has its own hard metadata dependency on this exact assembly, so it must be
         resolvable at our app's own base directory (or bundled into the single-file publish) regardless of
         whatever PIA state the target machine's GAC happens to be in.
         Real PowerPoint automation still requires PowerPoint desktop (not Office web-only) to be installed
         on the machine running this app — that part is unavoidable and separate from this file reference. -->
    <Reference Include="office">
      <HintPath>$(SystemRoot)\assembly\GAC_MSIL\office\15.0.0.0__71e9bce111e9429c\OFFICE.DLL</HintPath>
      <Private>true</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <!-- No more PresentationManager.Infrastructure reference - this app no longer touches PostgreSQL (or
         any EF Core type) directly. PresentationManager.ApiClient implements the same
         PresentationManager.Application.Interfaces repository/service interfaces over HTTP instead; see
         Program.cs's DI registrations. PresentationManager.TelegramBot stays for now (LoginForm/
         ForgotPasswordForm/SuperAdminPanelForm still use TelegramNotifier directly) - removing the bot
         token from this app is a later, separate change. -->
    <ProjectReference Include="..\PresentationManager.Application\PresentationManager.Application.csproj" />
    <ProjectReference Include="..\PresentationManager.ApiClient\PresentationManager.ApiClient.csproj" />
    <ProjectReference Include="..\PresentationManager.TelegramBot\PresentationManager.TelegramBot.csproj" />
  </ItemGroup>

</Project>
