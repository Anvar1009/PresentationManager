<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <!-- Same self-contained single-file shape as PresentationManager.UI.csproj - the server this runs on
       needs nothing pre-installed beyond the OS itself. -->
  <PropertyGroup>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
  </PropertyGroup>

  <ItemGroup>
    <!-- Unlike PresentationManager.UI's appsettings.json (embedded as a resource and seeded into %LocalAppData%
         on first run, so a single portable exe has nothing else to carry), this service is installed once on
         a fixed server path - a plain Content file sitting next to the exe is simpler and matches how
         appsettings.Local.json already overrides it below. Placeholder values only; real secrets belong in a
         gitignored appsettings.Local.json next to the installed exe, never committed. -->
    <Content Include="appsettings.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
    <Content Include="appsettings.Local.json" Condition="Exists('appsettings.Local.json')">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="8.0.1" />
    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" Version="8.0.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\PresentationManager.Application\PresentationManager.Application.csproj" />
    <ProjectReference Include="..\PresentationManager.Infrastructure\PresentationManager.Infrastructure.csproj" />
    <ProjectReference Include="..\PresentationManager.TelegramBot\PresentationManager.TelegramBot.csproj" />
  </ItemGroup>

</Project>
